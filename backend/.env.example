# Copy to .env and supply independent random hex secrets (32 bytes or more).
# python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=
# Local/hackathon dashboard login defaults. Set a unique 12+ character password in production.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin123
POSTGRES_PASSWORD=
REDIS_PASSWORD=
ENVIRONMENT=development
COOKIE_SECURE=false
DEBUG=false
ENABLE_API_AUTH=true
ENABLE_RATE_LIMITING=true
OUTPUT_SECURITY_MODE=FULL_BUFFER
DATABASE_URL=sqlite+aiosqlite:///./aegis_firewall.db
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o
UPSTREAM_ALLOWED_ORIGINS=[]
TOOL_ENDPOINTS={}
PROTECTED_OUTPUT_VALUES=[]
# Enable after installing the optional ML runtime and provisioning models.
REQUIRE_ML_MODELS=false
WOLF_DEFENDER_MODEL_PATH=models/wolf_defender
DEBERTA_MODEL_PATH=models/deberta-v3-base-prompt-injection-v2
LIGHTGBM_MODEL_PATH=models/lightgbm/model.txt
LAYA_MODEL_PATH=models/laya/multilingual
LAYA_ENGLISH_MODEL_PATH=models/laya/english
# Open-Jev is an optional typed-decision sidecar, for example http://127.0.0.1:8791.
OPEN_JEV_URL=
LOG_LEVEL=INFO
